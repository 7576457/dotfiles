input {
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="70%"
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle"
        }
        track-layout "window" 
        repeat-delay 250
        repeat-rate 40
    }
    touchpad {
        tap
        dwt
        dwtp
        click-method "clickfinger"
        tap-button-map "left-right-middle"
        natural-scroll
    }
    mouse {
        accel-speed 0.2
        accel-profile "flat"
    }
}
