// colorsschemer.ru #251F32 #1E1B25 #110A21 #7B6D99 #837999
layout {
    gaps 12
    empty-workspace-above-first
    center-focused-column "on-overflow"
    always-center-single-column
    background-color "#251f32"
    focus-ring { off; }
    border {
        on
        width 2
        active-gradient from="#8F7698" to="#7B6D99" angle=45
        inactive-color "#3a3150"
        urgent-color "#c26a77"
    }
    shadow {
        on
        softness 40
        spread 4
        color "#0009"
    }
    insert-hint {
        color "#8F7698aa"
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }
}
