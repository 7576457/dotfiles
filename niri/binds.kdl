binds {
    Mod+K                 hotkey-overlay-title="Keybinds" repeat=false { spawn "bash" "/home/hehs/.config/niri/binds-list.sh"; }
    Mod+T                 hotkey-overlay-title="File Manager" repeat=false { spawn "nautilus"; }
    Mod+D                 hotkey-overlay-title="Applications" repeat=false { spawn "fuzzel"; }

    Mod+Alt+L             hotkey-overlay-title="Lock Screen" { spawn "hyprlock"; }
    Mod+Alt+W             hotkey-overlay-title="Night Light" { spawn "/home/hehs/.config/waybar/warm.sh" "toggle"; }

    Mod+O                 hotkey-overlay-title="Overview" repeat=false { toggle-overview; }
    Mod+W                 hotkey-overlay-title="Close window" repeat=false { close-window; }
    Mod+Return            hotkey-overlay-title="Terminal" repeat=false { spawn "alacritty"; }
    Mod+Shift+Return      hotkey-overlay-title="Browser" repeat=false { spawn "firefox"; }
    Mod+Shift+E           hotkey-overlay-title="Logout" { quit; }

    // Звук, медиа и яркость
    XF86AudioRaiseVolume  hotkey-overlay-title="Увеличить громкость" allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume  hotkey-overlay-title="Уменьшить громкость" allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute         hotkey-overlay-title="Включить/выключить звук" allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      hotkey-overlay-title="Включить/выключить микрофон" allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay         hotkey-overlay-title="Воспроизведение/пауза" allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop         hotkey-overlay-title="Остановить воспроизведение" allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev         hotkey-overlay-title="Предыдущий трек" allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext         hotkey-overlay-title="Следующий трек" allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   hotkey-overlay-title="Увеличить яркость" allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown hotkey-overlay-title="Уменьшить яркость" allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Скриншоты
    Print                 hotkey-overlay-title="Скриншот области" { screenshot; }
    Mod+Print             hotkey-overlay-title="Скриншот экрана" repeat=false { screenshot-screen write-to-disk=false show-pointer=false; }
    Mod+Shift+Print       hotkey-overlay-title="Скриншот окна" repeat=false { screenshot-window write-to-disk=false show-pointer=false; }

    // Размеры окон
    Mod+Minus             hotkey-overlay-title="Уменьшить ширину окна на 25%" { set-column-width "-25%"; }
    Mod+Equal             hotkey-overlay-title="Увеличить ширину окна на 25%" { set-column-width "+25%"; }
    Mod+Shift+Minus       hotkey-overlay-title="Уменьшить высоту окна на 25%" { set-window-height "-25%"; }
    Mod+Shift+Equal       hotkey-overlay-title="Увеличить высоту окна на 25%" { set-window-height "+25%"; }

    Mod+F                 hotkey-overlay-title="Развернуть окно" { maximize-column; }
    Mod+Shift+F           hotkey-overlay-title="Полноэкранный режим" { fullscreen-window; }
    Mod+C                 hotkey-overlay-title="Центрировать окно" { center-column; }

    // Плавающие окна
    Mod+V                 hotkey-overlay-title="Переключить плавающий режим" { toggle-window-floating; }
    Mod+Shift+V           hotkey-overlay-title="Переключить фокус между плавающими и плиточными окнами" { switch-focus-between-floating-and-tiling; }

    // Рабочие столы: клавиатура
    Mod+Up                hotkey-overlay-title="Фокус на стол выше" { focus-workspace-up; }
    Mod+Down              hotkey-overlay-title="Фокус на стол ниже" { focus-workspace-down; }
    Mod+Right             hotkey-overlay-title="Фокус на колонку справа" { focus-column-right; }
    Mod+Left              hotkey-overlay-title="Фокус на колонку слева" { focus-column-left; }

    Mod+Ctrl+Up           hotkey-overlay-title="Переместить окно вверх" { move-column-to-workspace-up; }
    Mod+Ctrl+Down         hotkey-overlay-title="Переместить окно вниз" { move-column-to-workspace-down; }
    Mod+Ctrl+Right        hotkey-overlay-title="Переместить окно направо" { move-column-right; }
    Mod+Ctrl+Left         hotkey-overlay-title="Переместить окно налево" { move-column-left; }

    // Рабочие столы: мышь и тачпад
    Mod+WheelScrollUp              hotkey-overlay-title="Прокрутка: рабочий стол вверх" cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollDown            hotkey-overlay-title="Прокрутка: рабочий стол вниз" cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollRight           hotkey-overlay-title="Прокрутка: фокус вправо" cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft            hotkey-overlay-title="Прокрутка: фокус влево" cooldown-ms=150 { focus-column-left; }

    Mod+Shift+WheelScrollDown      hotkey-overlay-title="Прокрутка: фокус вправо" cooldown-ms=150 { focus-column-right; }
    Mod+Shift+WheelScrollUp        hotkey-overlay-title="Прокрутка: фокус влево" cooldown-ms=150 { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown hotkey-overlay-title="Прокрутка: переместить колонку вправо" cooldown-ms=150 { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   hotkey-overlay-title="Прокрутка: переместить колонку влево" cooldown-ms=150 { move-column-left; }
}
