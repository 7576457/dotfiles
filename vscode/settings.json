{
    "editor.wordWrap": "on",
    "editor.cursorBlinking": "solid",
    "editor.folding": false,
    "editor.fontSize": 16,
    "editor.rulers": [90],
    "editor.wordWrapColumn": 90,
    "editor.guides.indentation": true,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.scrollbar.vertical": "visible",
    "editor.scrollbar.horizontal": "hidden",
    "editor.renderWhitespace": "all",
    "editor.inlineSuggest.enabled": false,

    "breadcrumbs.enabled": false,
    "workbench.editor.showTabs": "none",
    "workbench.editor.tabActionCloseVisibility": false,
    "workbench.editor.enablePreview": false,
    "workbench.browser.showInTitleBar": false,
    "workbench.openInAgents.enabled": false,
    "workbench.panel.defaultLocation": "right",
    "workbench.statusBar.visible": false,
    "workbench.layoutControl.enabled": false,
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "hidden",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "Dark Modern",
    "workbench.settings.showAISearchToggle": false,

    "window.menuBarVisibility": "hidden",
    "window.commandCenter": false,
    "window.titleBarStyle": "native",
    "window.customTitleBarVisibility": "never",

    "chat.agent.enabled": false,
    "chat.disableAIFeatures": true,

    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,

    "files.autoSave": "onFocusChange",
    "files.exclude": {
        "**/.codex": true,
        "**/.agents": true,
        "**/.DS_Store": true,
        "**/node_modules": true,
        "**/bower_components": true,
        "**/__pycache__": true,
        "**/.cache": true,
        "**/.idea": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.venv": false,
        "**/.coverage": true,
        "**htmlcoverage": true,
        "**/docs/build": true
    },

    "telemetry.telemetryLevel": "off",

    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.defaultLocation": "view",
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.enableVisualBell": true,
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.initialHint": false,
    "terminal.integrated.tabs.enabled": false,

    "dart.enableSdkFormatter": true,
    "dart.enableServerSnippets": true,
    "dart.autoImportCompletions": true,
    "dart.warnWhenEditingFilesInPubCache": false,
    "dart.showDartPadSampleCodeLens": false,
    "dart.lspSnippetTextEdits": true,
    "[dart]": {
        "editor.tabSize": 2,
        "editor.formatOnSave": false,
        "editor.insertSpaces": true,
        "editor.rulers": [120]
    },
    "dart.lineLength": 120,

    "python.terminal.activateEnvironment": false,
    "git.openRepositoryInParentFolders": "never"
}
