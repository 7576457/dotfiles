{
  "spacing": 12,
  "margin-top": 3,
  "margin-left": 12,
  "margin-right": 12,
  "reload_style_on_change": true,
  "modules-left": [
    "niri/language",
    "idle_inhibitor",
    "custom/nightlight",
    "pulseaudio"
  ],
  "modules-right": [
    "clock",
    "network",
    "battery"
  ],
  "clock": {
    "format": "[ TIME: {:%H:%M:%S} ]",
    "interval": 1,
    "on-click": "date +'%d %B %Y%n%H:%M' | wl-copy -n",
    "tooltip": false,
    "cursor": false
  },
  "battery": {
    "format": "[ BATTERY: {capacity}% ]",
    "format-charging": "[ BATTERY: {capacity}% + ]",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": false
  },
  "network": {
    "interval": 5,
    "format-wifi": "[ NETWORK: Wi-Fi ]",
    "format-ethernet": "[ NETWORK: Ethernet ]",
    "format-linked": "[ NETWORK: off ]",
    "format-disconnected": "[ NETWORK: off ]",
    "format-disabled": "[ NETWORK: off ]",
    "tooltip": false
  },
  "pulseaudio": {
    "format": "[ VOLUME: {volume}% ]",
    "format-muted": "[ VOLUME: Muted ]",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip": false
  },
  "idle_inhibitor": {
    "format": "[ AWAKE: {icon} ]",
    "format-icons": {
      "activated": "On",
      "deactivated": "Off"
    },
    "tooltip": false
  },
  "niri/language": {
    "format": "[ LANGUAGE: {} ]",
    "format-en": "English",
    "format-ru": "Russian",
    "tooltip": false
  },
  "custom/nightlight": {
    "exec": "~/dotfiles/waybar/warm.sh",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "on-click": "~/dotfiles/waybar/warm.sh toggle",
    "tooltip": false
  }
}